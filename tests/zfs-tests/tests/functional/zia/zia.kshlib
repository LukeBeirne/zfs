. $STF_SUITE/include/libtest.shlib
. $STF_SUITE/tests/functional/redundancy/redundancy.kshlib
. $STF_SUITE/tests/functional/zia/zia.cfg

function default_zpool
{
    default_raidz_setup_noexit "${DISKS}"
    log_must zfs set compression=on "${TESTPOOL}"
    log_must zfs set checksum=on "${TESTPOOL}"
}

function zia_available
{
    zpool get -H -o value zia_available "${TESTPOOL}"
}

function dpusm_loaded
{
    if [[ "$(zia_available)" == "yes" ]]
    then
        lsmod | grep dpusm > /dev/null
        ret="$?"
        if [[ "${ret}" != "0" ]]
        then
            log_unsupported "dpusm not loaded"
        fi
    fi
}

# Providers can be loaded at any time after the dpusm
#
# The software provider must be loaded after ZFS since
# it uses ZFS symbols.
#
# If Z.I.A. is not available, the tests should still pass
#
function load_provider
{
    if [[ "$(zia_available)" == "yes" ]]
    then
        log_must insmod "${SBIN_DIR}/module/${PROVIDER}.ko"
    fi
}

# Every offload holds a reference to its provider,
# so they all have to be released before rmmod
function unload_provider
{
    if [[ "$(zia_available)" == "yes" ]]
    then
        log_must offload_none
        log_must rmmod "${PROVIDER_MODULE}"
    fi
}

# Without Z.I.A. or a loaded provider, only "off" can be set
function zia_offload_value
{
    if [[ "$(zia_available)" == "yes" ]] && \
        lsmod | grep -q "^${PROVIDER_MODULE} "
    then
        echo "${PROVIDER_MODULE}"
    else
        echo "off"
    fi
}

# values to loop over in loop_offloads_and_write
function zia_offload_values
{
    typeset provider="$(zia_offload_value)"
    if [[ "${provider}" == "off" ]]
    then
        echo "off"
    else
        echo "${provider} off"
    fi
}

function offload_all
{
    typeset provider="$(zia_offload_value)"

    log_must zpool set zia_compress="${provider}"   "${TESTPOOL}"
    log_must zpool set zia_checksum="${provider}"   "${TESTPOOL}"
    log_must zpool set zia_raidz1_gen="${provider}" "${TESTPOOL}"
    log_must zpool set zia_raidz2_gen="${provider}" "${TESTPOOL}"
    log_must zpool set zia_raidz3_gen="${provider}" "${TESTPOOL}"
    log_must zpool set zia_raidz1_rec="${provider}" "${TESTPOOL}"
    log_must zpool set zia_raidz2_rec="${provider}" "${TESTPOOL}"
    log_must zpool set zia_raidz3_rec="${provider}" "${TESTPOOL}"
    log_must zpool set zia_disk_write="${provider}" "${TESTPOOL}"
    log_must zpool set zia_file_write="${provider}" "${TESTPOOL}"
}

function offload_none
{
    log_must zpool set zia_disk_write="off" "${TESTPOOL}"
    log_must zpool set zia_file_write="off" "${TESTPOOL}"
    log_must zpool set zia_raidz1_rec="off" "${TESTPOOL}"
    log_must zpool set zia_raidz2_rec="off" "${TESTPOOL}"
    log_must zpool set zia_raidz3_rec="off" "${TESTPOOL}"
    log_must zpool set zia_raidz1_gen="off" "${TESTPOOL}"
    log_must zpool set zia_raidz2_gen="off" "${TESTPOOL}"
    log_must zpool set zia_raidz3_gen="off" "${TESTPOOL}"
    log_must zpool set zia_checksum="off"   "${TESTPOOL}"
    log_must zpool set zia_decompress="off" "${TESTPOOL}"
    log_must zpool set zia_compress="off"   "${TESTPOOL}"
    log_must zpool set zia_provider="off"   "${TESTPOOL}"
}

#
# loop through each combination of Z.I.A. offloads
# and make sure writing works
#
function loop_offloads_and_write
{
    typeset values="$(zia_offload_values)"

    for comp in ${values}
    do
        log_must zpool set zia_compress="${comp}" "${TESTPOOL}"

        for cksum in ${values}
        do
            log_must zpool set zia_checksum="${cksum}" "${TESTPOOL}"

            for raidz in ${values}
            do
                log_must zpool set zia_raidz1_gen="${raidz}" "${TESTPOOL}"
                log_must zpool set zia_raidz2_gen="${raidz}" "${TESTPOOL}"
                log_must zpool set zia_raidz3_gen="${raidz}" "${TESTPOOL}"

                for diskfile in ${values}
                do
                    log_must zpool set zia_disk_write="${diskfile}" "${TESTPOOL}"
                    log_must zpool set zia_file_write="${diskfile}" "${TESTPOOL}"

                    log_must file_write -o create -f "${FILENAME}" -b "${BLOCKSZ}" -c "${NUM_WRITES}" -d "${DATA}"
                    log_must ls -l "${FILENAME}"
                    log_must verify_pool "${TESTPOOL}"
                    log_must check_pool_status "${TESTPOOL}" "errors" "No known data errors"
                    log_must rm "${FILENAME}"
                done
            done
        done
    done
}

# copied from default_raidz_setup_noexit
function random_disk
{
    typeset disklist="$*"
    disks=(${disklist[*]})
    count="${#disks[*]}"
    idx="$(($(random 1 ${count}) - 1))"
    echo "${disks[${idx}]}"
}
